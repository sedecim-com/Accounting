# Dependencias y compilación
node_modules/
dist/
*.tsbuildinfo

# Configuración con secretos — NUNCA versionar
# Cualquier variante de .env, sólo con .env.example como excepción. El
# patrón era una lista —.env, .env.local, .env.backup-*— y una lista sólo
# cubre lo que alguien se acordó de escribir: `.env.old` o `.env.copia` no
# entraban. Con remoto configurado, un descuido ahí ya no es local.
.env*
!.env.example
.env.local
# Respaldos de .env: los valores de hoy son los de desarrollo, pero el
# siguiente respaldo puede llevar credenciales reales.
.env.backup-*
.env.*.local
mnemosine.config.json

# Material criptográfico real. Los certificados de tests/fixtures/certs son
# sintéticos (autofirmados, RFC AAA010101AAA) y los necesitan las pruebas:
# se exceptúan explícitamente más abajo.
*.key
*.pem
*.p12
*.pfx
!tests/fixtures/certs/*.key

# Bóveda local de desarrollo (material cifrado de e.firma/CSD)
.mnemosine/
vault-local/

# Salidas de herramientas
coverage/
.nyc_output/
*.log
npm-debug.log*

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Andamiaje de depuración: configuraciones de vitest de un solo uso y sus
# ganchos (p. ej. el que CONSERVA la base efímera de integración en vez de
# destruirla). Son de sesión, nunca del repositorio — misma razón por la que
# S2 dejó de versionar los respaldos de .env.
.tmp-*
