# Copia este archivo a .env y rellena los valores. .env NUNCA se versiona.
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME=mnemosine

# Rol de la APLICACIÓN: solo DML y sujeto a RLS. Sin contexto de tenant no ve nada.
DATABASE_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

REDIS_URL=

# OBLIGATORIOS en producción. Vacíos, el código cae a los valores de
# desarrollo ('dev-secret-change-me' y una llave de 32 bytes de ceros), que
# están en el repositorio: con ellos cualquiera firma un token de cualquier
# tenant y los datos bancarios quedan cifrados con una llave pública. Por eso
# src/config/index.ts se NIEGA a arrancar con NODE_ENV=production si siguen
# puestos. En desarrollo déjalos vacíos sin problema.
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# 64 caracteres hex: `openssl rand -hex 32`. Cambiarla después vuelve
# ilegible lo ya cifrado, así que fíjala antes de la primera escritura.
ENCRYPTION_KEY=

# Rol del OPERADOR: dueño del esquema y DDL. Solo lo usa `npm run migrate`.
MIGRATION_DATABASE_URL=

# Tenant por defecto del CLI. Con RLS activo, sin esto cada comando pide --tenant.
MNEMOSINE_TENANT=

# Rol con permiso de CREATE DATABASE, solo para la suite de integración
# (`npm run test:integration` crea y destruye una base efímera por corrida).
# mnemosine_owner NO lo tiene a propósito. En CI lo cubre el servicio postgres.
TEST_ADMIN_DATABASE_URL=
