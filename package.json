{
  "name": "accounting-core",
  "version": "1.0.0",
  "description": "Multi-country accounting core system (USA/Mexico) with multi-GAAP support",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "mnemosine": "tsx src/cli/mnemosine.ts",
    "build": "tsc && mkdir -p dist/ai/docs dist/database/migrations && cp src/ai/docs/*.md dist/ai/docs/ && cp src/ai/docs/*.json dist/ai/docs/ 2>/dev/null && cp src/database/migrations/*.sql dist/database/migrations/ && cp src/database/*.sql dist/database/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint src/ tests/ scripts/ --max-warnings 1235",
    "typecheck": "tsc --noEmit",
    "graphql:codegen": "graphql-codegen",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "plan:status": "tsx src/plan/status.ts",
    "catalogo:estado": "tsx scripts/catalogo-estado.ts",
    "costo:por-fila": "tsx scripts/costo-por-fila.ts",
    "reclass:iva-ppd": "tsx scripts/reclasificar-iva-ppd.ts",
    "backfill:account-roles": "tsx scripts/rellenar-roles-de-cuenta.ts",
    "corpus:estado": "tsx scripts/corpus-manifiesto.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@apollo/server": "^4.10.0",
    "@aws-sdk/client-secrets-manager": "^3.1121.0",
    "@graphql-tools/schema": "^10.1.0",
    "@types/node-forge": "^1.3.14",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "commander": "^15.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.0",
    "express": "^4.22.2",
    "fast-xml-parser": "^5.11.1",
    "graphql": "^16.8.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.5",
    "merkletreejs": "^0.6.0",
    "morgan": "^1.12.0",
    "node-forge": "^1.4.0",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "soap": "^1.11.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
