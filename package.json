{
  "name": "accounting-core",
  "version": "1.0.0",
  "description": "Multi-country accounting core system (USA/Mexico) with multi-GAAP support",
  "main": "dist/index.js",
  "bin": {
    "mnemosine": "dist/cli/mnemosine.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "mnemosine": "tsx src/cli/mnemosine.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -p tsconfig.web.json && node -e \"require('node:fs').cpSync('src/gateway/public', 'dist/gateway/public', { recursive: true })\"",
    "build:api": "tsc && mkdir -p dist/services/sat/anexo24 && cp -R src/services/sat/anexo24/xsd dist/services/sat/anexo24/ && mkdir -p dist/services/sat/cfdi40 && cp -R src/services/sat/cfdi40/xsd dist/services/sat/cfdi40/ && test -f dist/services/sat/anexo24/xsd/ContabilidadE/1_3/CatalogosParaEsqContE/CatalogosParaEsqContE.xsd && (mkdir -p dist/ai/docs dist/database/migrations && cp src/ai/docs/*.md dist/ai/docs/ && cp src/ai/docs/*.json dist/ai/docs/ 2>/dev/null && cp src/database/migrations/*.sql dist/database/migrations/ && cp src/database/*.sql dist/database/ 2>/dev/null || true)",
    "start": "node dist/index.js",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint src/ tests/ scripts/ --max-warnings 1106",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "verify": "bash scripts/verify.sh",
    "plan:status": "tsx src/plan/status.ts",
    "mutantes": "tsx scripts/mutantes.ts",
    "catalogo:estado": "tsx scripts/catalogo-estado.ts",
    "ux:status": "tsx scripts/ux-status.ts",
    "language:status": "tsx scripts/language-status.ts",
    "language:extract": "tsx scripts/language/extract.ts",
    "costo:por-fila": "tsx scripts/costo-por-fila.ts",
    "reclass:iva-ppd": "tsx scripts/reclasificar-iva-ppd.ts",
    "backfill:account-roles": "tsx scripts/rellenar-roles-de-cuenta.ts",
    "backfill:straddling-liabilities": "tsx scripts/resplit-straddling-liabilities.ts",
    "corpus:estado": "tsx scripts/corpus-manifiesto.ts",
    "historial:estado": "tsx scripts/historial-estado.ts",
    "mutation:census": "tsx scripts/mutation-census.ts",
    "openapi": "tsx scripts/openapi.ts",
    "eval": "tsx scripts/eval-clasificador.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@types/node-forge": "^1.3.14",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "commander": "^15.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.4",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.6",
    "merkletreejs": "^0.6.0",
    "morgan": "^1.12.1",
    "node-forge": "^1.4.3",
    "openai": "^7.23.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "soap": "^1.13.1",
    "uuid": "^14.0.2",
    "winston": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
